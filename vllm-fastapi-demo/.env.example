# Hugging Face model to load
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
SERVED_MODEL_NAME=qwen2.5-1.5b

# Keep this value identical in vLLM and the FastAPI gateway
VLLM_API_KEY=local-vllm-key

# Used when running FastAPI directly on the host.
# In Docker Compose, the API container overrides this with http://vllm:8000/v1
VLLM_BASE_URL=http://localhost:8000/v1

API_HOST=0.0.0.0
API_PORT=8080
REQUEST_TIMEOUT_SECONDS=120

# ================= 医疗 RAG 系统环境变量示例 =================
# 复制本文件为 .env 后按需修改；命令行参数优先级高于本文件。

# ---------- 模型路径 ----------
# 本地中文嵌入模型（BGE-M3，1024 维）
EMBED_MODEL_PATH=./rag/model/bge-m3
# 本地生成模型（Qwen3-0.6B，魔搭社区下载）
LLM_MODEL_PATH=./models/Qwen3-0.6B

# ---------- 生成后端 ----------
LLM_MODE=local

# 生成参数
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.2

# ---------- 检索与记忆 ----------
DEFAULT_TOP_K=3
MAX_HISTORY_TURNS=3

# ---------- 服务 ----------
DEFAULT_HOST=0.0.0.0
DEFAULT_PORT=8000
